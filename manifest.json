{
  "manifest_version": 3,
  "name": "AntiGem Browser Bridge",
  "short_name": "AntiGem",
  "version": "0.1.0",
  "description": "Lets your AntiGem agents in VS Code use this browser: only in the AntiGem tab group, and only after you allow other tabs.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AntiGem",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
